# ─────────────────────────────────────────────────────────────────────────
# EYRA storefront: environment variables (Vercel project settings)
#
# Copy to .env.local for local development. Every value below is a
# placeholder. Never commit real keys. Anything starting NEXT_PUBLIC_ is sent
# to the browser, so no secret may ever carry that prefix.
# ─────────────────────────────────────────────────────────────────────────

# ── Clerk (sign-in) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Medusa backend ───────────────────────────────────────────────────────
# The public address of the Medusa backend on Railway, no trailing slash.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://<your-backend>.up.railway.app
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Server only. A Medusa SECRET API key (sk_...). It has full admin power, so
# create a fresh one for production and never expose it to the browser.
MEDUSA_ADMIN_API_KEY=

# Shared with the backend: it calls the storefront with this to refresh pages
# and send team emails. Generate with: openssl rand -hex 32
STOREFRONT_REVALIDATE_SECRET=
# Its own secret for creating shipments and drawing invoice PDFs, because
# creating a shipment spends Shiprocket wallet money. Same value on the backend
# (STOREFRONT_SHIPMENT_SECRET). Set it on both at the same time.
STOREFRONT_SHIPMENT_SECRET=

# ── Product images ───────────────────────────────────────────────────────
# Build-time. Comma-separated EXACT hostnames Next may optimise images from:
# the S3 bucket (or CDN) Medusa uploads to. Wildcards are refused. The host is
# the one in the backend's S3_FILE_URL. EYRA's own domain is always allowed.
MEDUSA_IMAGE_HOSTS=<bucket>.s3.<region>.amazonaws.com

# ── Razorpay ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket ───────────────────────────────────────────────────────────
# Best: an API user, so the token is fetched and renewed by itself. Tokens
# last about ten days; a pasted SHIPROCKET_API_TOKEN stops working after that.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=
# Must match a pickup location in the Shiprocket dashboard exactly.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Shiprocket's webhook sends this as x-api-key.
SHIPROCKET_WEBHOOK_SECRET=
# Set to false to create shipments without booking the pickup.
# SHIPROCKET_AUTO_PICKUP=true
# Grams per item, for the parcel weight (a pair of anklets counts twice).
# SHIP_WEIGHT_RING_G=6
# SHIP_WEIGHT_CHAIN_G=15
# SHIP_WEIGHT_BRACELET_G=12
# SHIP_WEIGHT_ANKLET_G=10
# SHIP_WEIGHT_PENDANT_G=12
# SHIP_WEIGHT_EARRING_G=6

# ── Seller details, printed on every GST invoice ─────────────────────────
# SELLER_GSTIN is required: without a valid 15-character GSTIN an invoice is
# marked "not a valid tax invoice" and no invoice PDF is kept.
SELLER_GSTIN=
SELLER_LEGAL_NAME=
SELLER_ADDRESS_LINE1=
SELLER_ADDRESS_LINE2=
SELLER_CITY=
SELLER_STATE=
SELLER_PINCODE=
# JEWELRY_GST_RATE=3
# JEWELRY_HSN_CODE=7113

# ── Orders ───────────────────────────────────────────────────────────────
# Minutes an order is held (and can be cancelled) before it ships. Same value
# on the backend. 0 ships at once.
ORDER_CANCEL_WINDOW_MINUTES=
# ORDER_CANCEL_FEE is no longer used: an order cancelled before it ships is refunded in full, with nothing kept.
ORDERS_PUBLIC_EMAIL=
# Grievance officer mailbox shown on the grievance, privacy and terms pages (default grievance@eyra.org.in).
GRIEVANCE_PUBLIC_EMAIL=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
ORDER_EMAIL_FROM=
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_RECIPIENT=
# Where operational alerts go (shipping problems, missing refunds).
OPS_ALERT_EMAIL=

# ── Rate limiting (Upstash Redis). Without it rate limits are off and
#    payments rely on webhooks alone, so set it in production. ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admin and monitoring ─────────────────────────────────────────────────
RECONCILIATION_SECRET=
NEXT_PUBLIC_SENTRY_DSN=

# ── Launch mode: true serves the "Launching Soon" page on every page ─────
LAUNCH_MODE=false

# ── Returns, exchanges and credit notes ──────────────────────────────────
# Tax. The jewellery rate and HSN are JEWELRY_GST_RATE (3) and JEWELRY_HSN_CODE (7113) above.
# The Cash on Delivery charge is a service: 18% GST under SAC 9997. Set the same on the backend.
# COD_GST_RATE=18
# SERVICE_SAC_CODE=9997

# The free tote bag goes to Shiprocket at a price of zero. If Shiprocket turns a zero price away,
# set one_rupee: it is then sent at Rs 1 with a Rs 1 discount, which nets to zero.
# SHIPROCKET_FREE_GIFT_PRICE=zero

# Return pickups. Returns are brought to the registered address unless these are set.
# SHIPROCKET_RETURN_PHONE is required: Shiprocket needs a phone number for the warehouse.
SHIPROCKET_RETURN_PHONE=
# SHIPROCKET_RETURN_NAME=
# SHIPROCKET_RETURN_ADDRESS_1=
# SHIPROCKET_RETURN_ADDRESS_2=
# SHIPROCKET_RETURN_CITY=
# SHIPROCKET_RETURN_STATE=
# SHIPROCKET_RETURN_PINCODE=
# SHIPROCKET_RETURN_EMAIL=
# Weight of the tote bag in grams, for the parcel weight.
# SHIP_WEIGHT_TOTE_G=120

# WhatsApp messages (store credit issued, exchange payment link, replacement dispatched).
# WHATSAPP_PROVIDER is wati or aisensy; nothing is sent until one is fully set up.
# The template names must match the approved templates in the provider's dashboard.
WHATSAPP_PROVIDER=
WATI_API_URL=
WATI_ACCESS_TOKEN=
AISENSY_API_KEY=
# WHATSAPP_TEMPLATE_STORE_CREDIT=eyra_store_credit_issued
# WHATSAPP_TEMPLATE_EXCHANGE_LINK=eyra_exchange_payment_link
# WHATSAPP_TEMPLATE_REPLACEMENT=eyra_replacement_dispatched

# BIS Hallmarking registration number, shown in the footer, the trust bar and the
# authenticity page. The default is the registered number.
# BIS_REGISTRATION_NUMBER=HM/C-5890248421
# The official BIS Hallmark logo is public/images/bis-hallmark.jpg, downloaded from
# bis.gov.in. To change it, replace that file (or add bis-hallmark.svg / .png / .webp).
